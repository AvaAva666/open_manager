<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.automanager.demo.dashboard">

    <!-- 仪表屏悬浮窗权限（与宿主其他仪表一致，车机为系统签名环境） -->
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.SYSTEM_OVERLAY_WINDOW" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name">

        <!-- HelloWorld 仪表服务：声明 ACTION_DASHBOARD_SERVICE 供宿主 DbManager 扫描发现并绑定 -->
        <service
            android:name=".DashboardDemoService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.automanager.dashboard.action.DASHBOARD_SERVICE" />
            </intent-filter>
        </service>
    </application>

</manifest>
